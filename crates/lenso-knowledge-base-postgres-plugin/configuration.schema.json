{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "database_url_secret",
    "auth_issuer",
    "auth_assertion_public_key",
    "business_callers"
  ],
  "properties": {
    "schema": { "type": "string" },
    "database_url_secret": { "type": "string" },
    "auth_issuer": { "type": "string" },
    "auth_assertion_public_key": { "type": "string" },
    "business_callers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "public_read_grants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["caller_instance", "organization_id"],
        "properties": {
          "caller_instance": { "type": "string" },
          "organization_id": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
